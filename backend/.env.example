# Server
NODE_ENV=development
PORT=4000

# Database
# Hosted Postgres (Neon etc.) needs ?sslmode=require at the end.
DATABASE_URL=postgresql://ticket_app:changeme@localhost:5432/ticket_qr_db

# Auth
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=8h
COOKIE_NAME=tqg_session

# CORS / cookies
# Frontend origin(s). Comma-separate to allow more than one. No trailing slash.
CLIENT_URL=http://localhost:5173
# strict | lax | none. In production with frontend and API on different
# domains (vercel.app + onrender.com) use none; on one shared domain use lax.
# Defaults: lax in development, none in production.
# COOKIE_SAMESITE=none
# Number of reverse proxies in front of the API (Render = 1).
# TRUST_PROXY_HOPS=1

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# Ticketing
TICKET_TOKEN_SECRET=replace-this-with-another-long-random-string
